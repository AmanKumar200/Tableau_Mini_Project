    <dashboard name='Story 1' type='storyboard'>
      <layout-options>
        <title>
          <formatted-text>
            <run bold='true' fontalignment='1' fontcolor='#ffaa00' fontname='Benton Sans Book' underline='true'>&quot;Real Estate Sales: Data Overview&quot;</run>
            <run fontalignment='1'>Æ&#10;</run>
          </formatted-text>
        </title>
      </layout-options>
      <style>
        <style-rule element='story-point-caption'>
          <format attr='width' value='570' />
        </style-rule>
      </style>
      <size maxheight='964' maxwidth='1016' minheight='964' minwidth='1016' />
      <zones>
        <zone h='100000' id='2' type-v2='layout-basic' w='100000' x='0' y='0'>
          <zone h='98340' id='9' param='vert' removable='false' type-v2='layout-flow' w='98426' x='787' y='830'>
            <zone h='4564' id='10' type-v2='title' w='98426' x='787' y='830'>
              <zone-style>
                <format attr='border-color' value='#000000' />
                <format attr='border-style' value='none' />
                <format attr='border-width' value='0' />
                <format attr='margin' value='4' />
              </zone-style>
            </zone>
            <zone h='93776' id='7' param='vert' removable='false' type-v2='layout-flow' w='98426' x='787' y='5394'>
              <zone h='93776' id='1' param='vert' removable='false' type-v2='layout-flow' w='98426' x='787' y='5394'>
                <zone fixed-size='205' h='21266' id='4' is-fixed='true' paired-zone-id='5' removable='false' type-v2='flipboard-nav' w='98426' x='787' y='5394' />
                <zone h='72510' id='5' paired-zone-id='4' removable='false' type-v2='flipboard' w='98426' x='787' y='26660'>
                  <flipboard active-id='6' nav-type='caption' show-nav-arrows='true'>
                    <story-points>
                      <story-point caption='&quot;This chart shows the frequency distribution of Serial Number values in the dataset, with the highest concentration of records falling between 3.4B and 6.2B. Since Serial Number is a record identifier rather than a sales metric, this distribution reflects how records are indexed, not sales performance.&quot;' captured-sheet='Histogram' id='1' />
                      <story-point caption='&quot;Overall Yearly Trend&quot;- &quot;Total Assessed Value shows minimal activity in the dataset&apos;s earliest years, followed by sharp, sustained growth from the early 2010s onward. Values peaked at 40.25B before declining to 22.11B in the final year — consistent with the slowdown seen in year-on-year growth. Use the Selected Metric dropdown to view this trend by Sale Amount or other measures.&quot;' captured-sheet='Yearly Sales Trend' id='2' />
                      <story-point caption='&quot;Property Type Distribution&quot; -- &quot;Single Family homes dominate real estate sales, accounting for 80.23% of total sale amount — nearly six times all other property types combined. Condos are a distant second at 15.03%, while Two Family, Three Family, and Four Family properties together make up less than 5% of sales.&quot;' captured-sheet='Tree Map' id='3' />
                      <story-point caption='&quot;Town-wise Performance &amp; Sales Ratio&quot;--&quot;This table shows average Sales Ratio (assessed value relative to sale price) by town and residential type. Ratios generally cluster around 0.7–1.3, indicating assessed values are broadly aligned with market sale prices across property types and towns.&quot;' captured-sheet='Highlight Map' id='4' />
                      <story-point caption='Hot Spring is the town which shows higher Sales Amount of around &quot;9625666905&quot; total .' captured-sheet='Text Chart' id='7' />
                      <story-point caption='&quot;This dashboard summarizes real estate sales trends from 1999–2022 across residential property types, towns, and states. Sales activity was minimal before 2011 and accelerated sharply from 2020 onward, peaking at 17.16% year-on-year growth in 2021. Single Family homes account for 80% of total sale value, and sales are broadly distributed across towns with no single market dominating. Filters for Sale Year, Property Type, and Town allow drill-down into specific segments.&quot;' captured-sheet='Dashboard 1' id='5' />
                      <story-point caption='&quot;This summary translates the dashboard&apos;s findings into business terms: prioritize Single Family investment, diversify across towns rather than chasing a single market, and move cautiously given the 2022 growth slowdown. Sales Ratio can serve as a pricing sanity-check once outlier transactions are excluded from the data.&quot;' captured-sheet='Dashboard 2' id='6' />
                    </story-points>
                  </flipboard>
                </zone>
              </zone>
            </zone>
          </zone>
          <zone-style>
            <format attr='border-color' value='#000000' />
            <format attr='border-style' value='none' />
            <format attr='border-width' value='0' />
            <format attr='margin' value='8' />
          </zone-style>
        </zone>
      </zones>
      <simple-id uuid='{F1CF08D9-05EF-40EF-BA95-73DD6D4310E7}' />
    </dashboard>
  </dashboards>
